# ---- dependencies ----
node_modules/

# ---- build output ----
dist/
build/
web-build/
*.tsbuildinfo

# ---- Expo / Metro ----
.expo/
.metro-health-check*
expo-env.d.ts

# ---- Android (generated build artifacts; source under mobile/android is tracked) ----
.gradle/
.kotlin/
.cxx/
local.properties
*.iml
*.hprof
*.jsbundle
mobile/android/app/src/main/java/inline/

# ---- iOS ----
mobile/ios/Pods/
mobile/ios/build/

# ---- signing keys: NEVER commit ----
# Passwords live in ~/.gradle/gradle.properties (machine-local).
*.keystore
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
# debug keystore is a well-known public key, safe and needed for debug builds
!mobile/android/app/debug.keystore

# ---- app packages ----
*.apk
*.aab
*.ipa

# ---- server runtime data (sqlite db + user uploads) ----
server/data/

# ---- secrets / local env (.env.example stays tracked) ----
.env
.env.local
.env*.local

# ---- logs ----
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
